1,1,00004708:stage_select_menu_resume
1,1,000047CC:stage_select_menu_exit_handler
1,1,0003EBA8:debug_text_color_hook_resume
1,1,000BA770:pause_menu_text_hook_resume
1,1,000BAC3C:titlescreen_text_color_hook_resume

// Data symbols
1,5,0003B38C:titlescreen_press_start_string
